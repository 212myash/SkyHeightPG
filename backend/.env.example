# ===================================================
# SKY HEIGHT PG BACKEND — ENVIRONMENT CONFIGURATION
# ===================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT COMMIT SENSITIVE VALUES OR YOUR .env FILE TO GIT!
# ===================================================

# Server Port (Render sets this dynamically; defaults to 5000 locally)
PORT=5000

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=production

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/skyheightpg?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/skyheightpg?retryWrites=true&w=majority

# JSON Web Token Secret Key
# Generate a strong 32+ character random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_jwt_secret_key_here

# Allowed CORS Origins (Comma-separated for web clients; optional for mobile Flutter apps)
# Example: https://skyheightpg.onrender.com,https://app.skyheightpg.in
ALLOWED_ORIGINS=

# Optional: Set to 'true' to force custom DNS servers (8.8.8.8, 8.8.4.4)
# CUSTOM_DNS=false
