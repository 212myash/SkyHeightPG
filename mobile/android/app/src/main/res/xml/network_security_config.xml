<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production Base Configuration: Cleartext HTTP is disallowed; HTTPS is strictly enforced -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
